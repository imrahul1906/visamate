{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisaTypes",
  "type": "object",
  "properties": {
    "countryId": {"type": "string"},
    "countryCode": {"type": "string"},
    "countryName": {"type": "string"},
    "process": {
      "type": "object",
      "properties": {
        "default": {
          "type": "object",
          "properties": {
            "applicationMode": {"type": "string"},
            "biometricRequired": {"type": "boolean"},
            "interviewRequired": {"type": "boolean"}
          }
        }
      }
    },
    "visaTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "code": {"type": "string"},
          "name": {"type": "string"},
          "category": {"type": "string"},
          "maxStayDays": {"type": "integer"},
          "fees": {"type": "number"},
          "currency": {"type": "string"},
          "note": {"type": "string"},
          "vfsCharges": {
            "type": "object",
            "properties": {
              "serviceCharge": {
                "type": "object",
                "properties": {
                  "charge": {"type": "number"},
                  "currency": {"type": "string"},
                  "refundable": {"type": "boolean"},
                  "note": {"type": "string"}
                },
                "required": ["charge", "currency"]
              },
              "courierCharges": {
                "type": "object",
                "properties": {
                  "charge": {"type": "number"},
                  "currency": {"type": "string"},
                  "optional": {"type": "boolean"},
                  "note": {"type": "string"}
                },
                "required": ["charge", "currency"]
              }
            }
          },
          "process": {
            "type": "object",
            "properties": {
              "paymentInstructions": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "status": {"type": "string"},
              "lastUpdated": {"type": "string"}
            }
          }
        },
        "required": ["id", "code", "name"]
      }
    }
  },
  "required": ["countryId", "countryCode", "countryName", "visaTypes"],
  "additionalProperties": false
}
